# Registry configuration
REGISTRY_DOMAIN=cpricedomain.net
REGISTRY_BASE_URL=https://cpricedomain.net
REGISTRY_KEY_PATH=registry.key.pem
DATABASE_URL=sqlite:///./registry.db

# Enrollment auth — operator public keys the registry trusts for minting.
# Generate with: python operator_cli.py jwks --key operator.key.pem --out operator_jwks.json
OPERATOR_JWKS_PATH=operator_jwks.json
REQUIRE_ENROLLMENT_VOUCHER=true

# Charter lifetime in days (0 = no expiry)
CHARTER_TTL_DAYS=90

# Used by registry_client.py
AGENT_REGISTRY_URL=https://cpricedomain.net
# Operator-signed enrollment voucher the agent presents at provision time
# AGENT_ENROLLMENT_VOUCHER=
